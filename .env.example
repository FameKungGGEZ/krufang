# Copy to .env.local and replace these placeholders with your Supabase project values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Set true only for isolated local UI development; it disables Supabase and admin login.
VITE_USE_LOCAL_STORAGE=false
